--  MANUAL HEIGHT OFFSET (EDIT THIS, THEN RE-EXEC)
--========================================================
local RimDotHeightOffset = 41.45

-- Rim size ID
local RimSize = Vector3.new(3.632131576538086, 0.5587897300720215, 3.632131576538086)

-- State
local RimDots = {}
local DotsEnabled = true
local holdingF = false
local AIM_STEP_NAME = "RimDot_AimLock"

