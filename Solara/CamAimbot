--========================================================
--  DOT MANAGEMENT
--========================================================
local function AddRimDot(rim)
    if RimDots[rim] then return end

    local dot = Drawing.new("Circle")
    dot.Radius = 4
    dot.Filled = true
    dot.Color = Color3.new(1, 0, 0)
    dot.Visible = true

    RimDots[rim] = dot
end

local function RemoveRimDot(rim)
    local dot = RimDots[rim]
    if dot then
        pcall(function()
            if dot.Remove then dot:Remove()
            elseif dot.Destroy then dot:Destroy() end
        end)
        RimDots[rim] = nil
    end
end

