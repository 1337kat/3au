    if not DotsEnabled then
        for _, dot in pairs(RimDots) do
            dot.Visible = false
        end
        return
    end

    for rim, dot in pairs(RimDots) do
        if rim:IsDescendantOf(workspace) then
            local worldPos = rim.Position + Vector3.new(0, RimDotHeightOffset, 0)
            local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)

            dot.Position = Vector2.new(screenPos.X, screenPos.Y)
            dot.Visible = onScreen
        else
            dot.Visible = false
        end
    end
end))

-- Detect new rims
bind(workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("BasePart") and obj.Name == "Rim" and obj.Size == RimSize then
        AddRimDot(obj)
    end
end))

bind(workspace.DescendantRemoving:Connect(function(obj)
    if RimDots[obj] then RemoveRimDot(obj) end
end))

-- Pre-existing rims
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("BasePart") and obj.Name == "Rim" and obj.Size == RimSize then
        AddRimDot(obj)
    end
end

-- Toggle dots (O)
bind(UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.O then
        DotsEnabled = not DotsEnabled
    end
end))

--========================================================
--       *** FIXED SECTION — PLAYER PROXIMITY RIM ***
--========================================================

local function GetClosestRimToPlayer()
    local char = localPlayer.Character
    if not char then return nil end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local closest, bestDist = nil, math.huge

    for rim in pairs(RimDots) do
        if rim:IsDescendantOf(workspace) then
            local dist = (rim.Position - hrp.Position).Magnitude
            if dist < bestDist then
                bestDist = dist
                closest = rim
            end
        end
    end

    return closest
end

local function AimStep()
    if not holdingF then return end

    local rim = GetClosestRimToPlayer()
    if rim then
        local aimPos = rim.Position + Vector3.new(0, RimDotHeightOffset, 0)
        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.new(camPos, aimPos)
    end
