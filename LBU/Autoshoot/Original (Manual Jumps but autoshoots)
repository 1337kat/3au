-- AutomatedPerfectShot.lua
-- Always-on automated shot assist: auto-calibrate, auto-rim, auto-shoot.
-- Minimal toasts, NO green glow visuals, no V-toggle. Optional: hold F to pause.
-- Y key = lock/unlock the nearest visible rim under cursor.

local Players = game:GetService('Players')
local UserInputService = game:GetService('UserInputService')
local RunService = game:GetService('RunService')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local CoreGui = game:GetService('CoreGui')
local TweenService = game:GetService('TweenService')
local Workspace = game:GetService('Workspace')
local Camera = workspace.CurrentCamera

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()

-- ====================== STATE ======================
getgenv().PAYLOAD0_SYSTEM_ACTIVE = true
local SystemActive           = true          -- Always on by default
local shootKey               = nil           -- captured from legit rc
local selectedRim            = nil           -- auto-selected rim
local manualRim              = nil           -- Y-key locked rim
local activeNotifyGui        = nil
local ballTool               = nil
local shootRemote            = nil
local hookedMeta             = nil

-- Optional pause (hold F to pause everything)
local fKeyDown               = false

-- ====================== CONFIG =====================
-- If your game uses specific perfect distances, edit this table:
local PERFECT_DISTANCES      = { 54.97, 61.53, 68.10, 68.80 }
local ACTIVE_RANGE_MAIN      = 90
local PERFECT_TOL            = 0.12          -- window for perfect distance
local PREDICTIVE_BIAS        = 2.0           -- extend tolerance for predicted frame
local SINGLE_SHOT_PER_JUMP   = true

-- Rim signature (use the common Rim size used in your place)
local RimSize                = Vector3.new(3.632131576538086, 0.5587897300720215, 3.632131576538086)

-- If your remote expects a power/metadata payload, keep these:
local SHOOT_POWER            = 75            -- preserved default power
local INCLUDE_TEMPLATE_ARGS  = true          -- reuse captured argument template if seen

-- ====================== HELPERS ====================
local function notify(msg: string)
    if activeNotifyGui and activeNotifyGui.Parent then
        activeNotifyGui:Destroy()
    end
    local gui = Instance.new('ScreenGui')
    gui.ResetOnSpawn = false
    gui.Name = "PAYLOAD0_Toast"
    gui.Parent = CoreGui
    activeNotifyGui = gui

    local label = Instance.new('TextLabel')
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.Position = UDim2.new(0.5, 0, 0.9, 0)
    label.Size = UDim2.new(0, 560, 0, 38)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Code
    label.TextSize = 26
    label.TextColor3 = Color3.fromRGB(255,255,255)
    label.Text = msg
    label.Parent = gui

    task.delay(0.9, function()
        if gui == activeNotifyGui then
            gui:Destroy()
            activeNotifyGui = nil
        end
    end)
end

local function hasBall(): boolean
    local c = plr.Character
    if not c then return false end
    for _, tool in ipairs(c:GetChildren()) do
        if tool:IsA('Tool') and tool.Name:lower():find('ball') then
            ballTool = tool
            return true
        end
    end
    ballTool = nil
    return false
end

-- =================== CALIBRATE UI ==================
local calibrateGui
local function showCalibrateUI()
    if calibrateGui or shootKey or not hasBall() then return end
    calibrateGui = Instance.new('ScreenGui')
    calibrateGui.Name = 'CalibrateReminder'
    calibrateGui.ResetOnSpawn = false
    calibrateGui.IgnoreGuiInset = true
    calibrateGui.Parent = CoreGui

    local frame = Instance.new('Frame')
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.new(0.5, 0, 0.85, 0)
    frame.Size = UDim2.new(0, 420, 0, 45)
    frame.BackgroundTransparency = 0.25
    frame.BackgroundColor3 = Color3.fromRGB(20,20,20)
    frame.BorderSizePixel = 0
    frame.Parent = calibrateGui

    local corner = Instance.new('UICorner')
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local label = Instance.new('TextLabel')
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 22
    label.TextColor3 = Color3.fromRGB(220, 255, 220)
    label.Text = 'Click once to calibrate (key capture).'
