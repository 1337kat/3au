local function hasBall()
    local c = plr.Character
    if not c then
        return false
    end
    for _, tool in ipairs(c:GetChildren()) do
        if tool:IsA('Tool') and tool.Name:lower():find('ball') then
            ballTool = tool
            return true
        end
    end
    ballTool = nil
    return false
end

