-- Apply handlers
local function toNum(v) return tonumber(v) end

local function applyField(name, val)
    if name == "PERFECT_TOL" then
        PERFECT_TOL = toNum(val) or PERFECT_TOL
    elseif name == "APEX_SOFT_TOL" then
        APEX_SOFT_TOL = toNum(val) or APEX_SOFT_TOL
    elseif name == "STICKY_WINDOW" then
        STICKY_WINDOW = toNum(val) or STICKY_WINDOW
    elseif name == "MIN_JUMP_VELOCITY" then
        MIN_JUMP_VELOCITY = toNum(val) or MIN_JUMP_VELOCITY
    elseif name == "NEAR_APEX_VEL" then
        NEAR_APEX_VEL = toNum(val) or NEAR_APEX_VEL
    elseif name == "APEX_DELAY_CAP" then
        APEX_DELAY_CAP = toNum(val) or APEX_DELAY_CAP
    elseif name == "APEX_BIAS" then
        APEX_BIAS = toNum(val) or APEX_BIAS
    elseif name == "SINGLE_SHOT_PER_JUMP (true/false)" then
        local s = tostring(val):lower()
        SINGLE_SHOT_PER_JUMP = (s == "true" or s == "1" or s == "yes" or s == "y")
    elseif name == "PERFECT_DISTANCES (csv)" then
        local t = {}
        for num in tostring(val):gmatch("[0-9%.%-]+") do
            local n = tonumber(num)
            if n then table.insert(t, n) end
        end
        if #t > 0 then PERFECT_DISTANCES = t end
    end
end

