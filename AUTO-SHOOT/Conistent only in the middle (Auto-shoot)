-- === PERFECT RANGE SOURCES (Lol under Rim) ===
local rimsForPush = {}
for _, v in ipairs(Workspace:GetDescendants()) do
    if
        v:IsA('BasePart')
        and v.Name == 'Lol'
        and v.Parent
        and v.Parent.Name == 'Rim'
    then
        table.insert(rimsForPush, v)
    end
end

local function nearestRim(rootPos)
    local nearest, nearestDist
    for _, rim in ipairs(rimsForPush) do
        if rim:IsDescendantOf(Workspace) then
            local rimXZ = Vector3.new(rim.Position.X, 0, rim.Position.Z)
            local dist = (rimXZ - Vector3.new(rootPos.X, 0, rootPos.Z)).Magnitude
            if not nearestDist or dist < nearestDist then
                nearest, nearestDist = rim, dist
            end
        end
    end
    return nearest, nearestDist
end

local function getNearestPerfectDistance(current)
    local nearest, smallestDiff
    for _, pd in ipairs(PERFECT_DISTANCES) do
        local diff = math.abs(pd - current)
        if not smallestDiff or diff < smallestDiff then
            nearest, smallestDiff = pd, diff
        end
    end
    return nearest
end

-- === JUMP/APEX STATE ===
local apexScheduledToken = 0
local perJumpShotDone = false
local lastPerfectTick = 0

local function isAirborne(hum)
    if not hum then
        return false
    end
    local st = hum:GetState()
    return not (
        st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.RunningNoPhysics
        or st == Enum.HumanoidStateType.Landed
        or st == Enum.HumanoidStateType.Seated
    )
end

local function resetJump()
    apexScheduledToken += 1 -- cancels pending delays
    perJumpShotDone = false
end

plr.CharacterAdded:Connect(function(c2)
    task.wait(0.5)
    hl.Adornee = c2
    resetJump()
end)

-- micro-ground watcher to reset immediately on land
task.spawn(function()
    while task.wait(0.04) do
        local hum = plr.Character
            and plr.Character:FindFirstChildOfClass('Humanoid')
        if hum and not isAirborne(hum) then
            if perJumpShotDone then
                -- next jump can shoot again
                perJumpShotDone = false
            end
        end
    end
end)

-- === CORE LOOP (RenderStepped) ===
RunService.RenderStepped:Connect(function()
    if not getgenv().PAYLOAD0_SYSTEM_ACTIVE then
        hl.Enabled = false
        return
    end
    local c = plr.Character
    local hum = c and c:FindFirstChildOfClass('Humanoid')
    local root = c and c:FindFirstChild('HumanoidRootPart')
    if not (hum and root) or not hasBall() then
        hl.Enabled = false
        return
    end

    local rim, dist = nearestRim(root.Position)
    if not rim or dist > ACTIVE_RANGE_MAIN then
        hl.Enabled = false
        return
    end
    local target = getNearestPerfectDistance(dist)
    local diff = dist - target
    local absDiff = math.abs(diff)

    -- visuals
    if VisualsEnabled then
        if absDiff <= PERFECT_TOL then
            hl.Enabled = true
            hl.FillColor, hl.OutlineColor = COLOR_GREEN, COLOR_GREEN
        elseif absDiff < CLAMP_RADIUS then
            hl.Enabled = true
            hl.FillColor, hl.OutlineColor = COLOR_GREEN_SOFT, COLOR_GREEN_SOFT
        else
            hl.Enabled = false
        end
    else
        hl.Enabled = false
    end

    -- sticky perfect memory
    if absDiff <= PERFECT_TOL then
        lastPerfectTick = tick()
    end
    local recentlyPerfect = (tick() - lastPerfectTick) <= STICKY_WINDOW

    -- airborne & vertical velocity
    local yVel = (root.AssemblyLinearVelocity or root.Velocity).Y
    local airborne = yVel > MIN_JUMP_VELOCITY or isAirborne(hum)

    -- quick recheck at fire-time
    local function stillValid(token)
        if token and token ~= apexScheduledToken then
            return false
        end
        if not getgenv().PAYLOAD0_SYSTEM_ACTIVE or not hasBall() then
            return false
        end
        if not rim:IsDescendantOf(Workspace) then
            return false
        end
        local _, dNow = nearestRim(root.Position)
        if not dNow then
            return false
        end
        local tNow = getNearestPerfectDistance(dNow)
        local ok = math.abs(dNow - tNow) <= (PERFECT_TOL + APEX_SOFT_TOL)
            or (tick() - lastPerfectTick) <= STICKY_WINDOW
        return ok
            and (
                isAirborne(hum)
                or ((root.AssemblyLinearVelocity or root.Velocity).Y > 0.5)
            )
    end

    local function tryShootNow()
        if SINGLE_SHOT_PER_JUMP and perJumpShotDone then
            return
        end
        shootAtTarget()
        perJumpShotDone = true
    end

    if airborne and (absDiff <= PERFECT_TOL or recentlyPerfect) then
        -- If falling or near-apex -> fire immediately (no delay)
        if yVel <= NEAR_APEX_VEL then
            if stillValid() then
                tryShootNow()
            end
            return
        end

        -- Rising & early: ultra-short biased wait toward apex (pre-apex feel)
        local g = Workspace.Gravity
        local t_to_apex = math.clamp((yVel / g) * APEX_BIAS, 0, APEX_DELAY_CAP)

        if t_to_apex <= 0.005 then
            -- basically next frame is fine
            RunService.Heartbeat:Wait() -- micro-smooth
            if stillValid() then
                tryShootNow()
            end
        else
            local token = apexScheduledToken
            task.delay(t_to_apex, function()
                if stillValid(token) then
                    tryShootNow()
                end
            end)
        end
    end
end)

-- === Ensure per-jump reset on explicit land ===
task.spawn(function()
    local lastState
    while task.wait(0.02) do
        local hum = plr.Character
            and plr.Character:FindFirstChildOfClass('Humanoid')
        if hum then
            local st = hum:GetState()
            if st ~= lastState then
                if
                    st == Enum.HumanoidStateType.Landed
                    or st == Enum.HumanoidStateType.Running
                    or st == Enum.HumanoidStateType.Seated
                then
                    resetJump()
                end
                lastState = st
            end
        end
    end
end)
